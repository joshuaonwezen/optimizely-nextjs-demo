# Optimizely Graph
OPTIMIZELY_GRAPH_SINGLE_KEY=
OPTIMIZELY_GRAPH_GATEWAY=https://cg.optimizely.com/content/v2

# Optimizely CMS
OPTIMIZELY_CMS_URL=
NEXT_PUBLIC_OPTIMIZELY_CMS_URL=

# Graph admin Basic auth (key + secret): webhook registration, Content Source API
# syncs (seed-quotes, seed-locations), search config, and /preview/share drafts.
OPTIMIZELY_APP_KEY=
OPTIMIZELY_APP_SECRET=

# Optimizely CMS Management API (used by seed scripts)
OPTIMIZELY_CMS_CLIENT_ID=
OPTIMIZELY_CMS_CLIENT_SECRET=
OPTIMIZELY_ROOT_CONTAINER=       # key of the root CMS container — create it in the CMS UI, then copy its key here

# Optional seed overrides - normally auto-discovered via Graph
# OPTIMIZELY_CONTACT_FORM_KEY=   # native Form Container block (seed-contact-form, seed-contact-pages)
# OPTIMIZELY_NAV_BLOCK_KEY=      # existing Navigation block to rebuild (seed-nav)
# SEED_FRESH=1                   # destructive rebuild, same as `npm run seed:all -- --fresh`
# SEED_LOCALIZE=1                # include the Dutch localization step

# Absolute site origin for sitemap.xml / robots.txt. Unset: the Vercel production
# domain (VERCEL_PROJECT_PRODUCTION_URL) when deployed there, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Security — change this before deploying
OPTIMIZELY_REVALIDATE_SECRET=

# Mark (Agent Platform) workflows - see mark/README.md. All optional.
# The bearer token of the Tool Registry entry for /api/mark/discovery. Unset = every
# tool call under /api/mark/tools/ answers 503.
MARK_TOOLS_BEARER=
# Webhook trigger of each workflow, and its whole auth header value ("Bearer <key>").
# Both are secrets: a POST to the URL starts a paid run. Unset = that workflow never starts.
MARK_ON_PUBLISH_URL=
MARK_ON_PUBLISH_AUTH=
MARK_ON_TRANSLATE_URL=
MARK_ON_TRANSLATE_AUTH=
MARK_ON_REVIEW_URL=
MARK_ON_REVIEW_AUTH=
# Comma-separated emails allowed to start runs. Empty = any person (never an API client).
MARK_TRIGGER_USERS=
# MARK_WORKFLOWS_ENABLED=false
# MARK_DEBOUNCE_MINUTES=2
# MARK_FRESH_MINUTES=10
# MARK_REVIEW_STATUSES=InReview,Ready
# Languages "translate on publish" translates into (default nl), from MARK_TRANSLATE_SOURCE_LOCALE (default en).
# MARK_TRANSLATE_LOCALES=nl

# Signs external preview links (/preview/share). Any random string. Rotating it
# invalidates every outstanding external preview link. Unset = feature disabled.
OPTIMIZELY_PREVIEW_SECRET=

# Optimizely Feature Experimentation - production SDK key of the "SaaS CMS ProServ"
# project (5152837204705280). Also read by scripts/send-experiment-odp-events.mjs (npm run exp:seed) to fetch
# the datafile and emit real impression/conversion events for the daily demo seed,
# and by scripts/send-ga4-events.mjs for the fake exp_variant_string param (optional
# there - a hardcoded fallback experiment pool is used when this is unset).
OPTIMIZELY_FX_SDK_KEY=
# Same SDK key, exposed to the browser: client-side decisions (useFxDecision,
# FxBucketingEvent) load the datafile with it. Unset = browser FX silently does nothing.
NEXT_PUBLIC_OPTIMIZELY_FX_SDK_KEY=

# Optimizely Web Experimentation — snippet project ID only (the numeric id in
# cdn.optimizely.com/js/<id>.js, loaded from the root layout). Unset falls back
# to the "SaaS CMS ProServ - Web" project (5018738125176832), same account as FX.
NEXT_PUBLIC_OPTIMIZELY_WEB_SNIPPET_ID=

# Optimizely Data Platform (ODP) — for direct segment-based personalization.
# OPTIMIZELY_ODP_API_KEY + _HOST are also used by exp:seed to POST fake pageview /
# conversion events and known-customer profiles to /v3/events and /v3/profiles.
NEXT_PUBLIC_OPTIMIZELY_ODP_TRACKER_ID=   # public tracker ID for the client-side tag; unset falls back to the demo tracker
OPTIMIZELY_ODP_API_KEY=                  # same value — used server-side for segment queries
OPTIMIZELY_ODP_API_HOST=https://api.zaius.com

# Experimentation REST API, local scripts only (scripts/seed-fx-project.ts,
# scripts/seed-wx-project.ts, scripts/maintenance/sync-attribute-docs.ts).
# A personal access token for the account that owns both projects; never a CI secret.
# OPTIMIZELY_FX_API_TOKEN=
# OPTIMIZELY_FX_PROJECT_ID=5152837204705280
# OPTIMIZELY_WX_PROJECT_ID=5018738125176832

# GA4 Measurement Protocol (used by scripts/send-ga4-events.mjs)
# NOTE: the Measurement ID here must be the stream the API secret was created under.
# The fake-data property is G-EKYQLXD2VB, NOT the app's client-side G-2MTP98PSWL.
GA4_MEASUREMENT_ID=G-EKYQLXD2VB           # stream that owns the API secret below
GA4_API_SECRET=                           # GA4 Admin -> Data Streams -> that stream -> Measurement Protocol API secrets

# Ingestion health check (optional but recommended). The live endpoint returns 204
# even for a dead/mismatched secret, so a green run does not prove data landed. Set
# both and the seeder reads the events back via the Data API and FAILS on 0 ingestion.
# GA4_PROPERTY_ID=                        # numeric property id (Admin -> Property Settings)
# GA4_SA_KEY=                             # service-account JSON (one line), Viewer on the property
